<?xml version="1.0" encoding="utf-8"?>
<dialog width="970" height="570" title="Character Editor - New Character">
  <vbox width="100%" height="100%">
    <card width="100%" height="50%" text="Create New">
      <scrollview width="100%" height="100%" contentWidth="100%" contentHeight="100%">
        <hbox width="100%" height="100%">
          <style>
            .bigAssButton {
            font-size: 55px;
            font-weight: bold;
            width: 100%;
            height: 100%;
            }
          </style>
          <button id="splashSparrowButton" text="Sparrow" styleNames="bigAssButton" />
          <button id="splashPackerButton" text="Packer" styleNames="bigAssButton" />
          <button id="splashAtlasButton" text="Animate Atlas" styleNames="bigAssButton" />
        </hbox>
      </scrollview>
    </card>
    <hbox width="100%" height="50%">
      <card width="50%" height="100%" text="Open Recent">
        <scrollview width="100%" height="100%" contentWidth="100%">
          <vbox width="100%" id="splashRecentContainer" />
        </scrollview>
        <button id="splashBrowse" text="Browse for Character" />
      </card>
      <card width="50%" height="100%" text="Create From Character">
        <scrollview width="100%" height="100%" contentWidth="100%">
          <vbox width="100%" id="splashTemplateContainer" />
        </scrollview>
      </card>
    </hbox>
  </vbox>
</dialog>
